FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ARG VP_BUILD_COMMIT
RUN printf '%s\n' "$VP_BUILD_COMMIT" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision=$VP_BUILD_COMMIT
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common ca-certificates gnupg \
    ffmpeg libpq-dev gcc \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.12 /usr/bin/python \
    && python3.12 -m venv ${VIRTUAL_ENV} \
    && ${VIRTUAL_ENV}/bin/pip install --upgrade pip setuptools wheel

WORKDIR /app
COPY pyproject.toml .
RUN pip install ".[worker]" \
    && pip install nvidia-cublas-cu12 nvidia-cudnn-cu12

COPY app /app/app
COPY worker /app/worker
RUN printf 'BUILD_COMMIT = "%s"\n' "$VP_BUILD_COMMIT" \
    > /app/worker/_build_identity.py \
    && chmod 0444 /app/worker/_build_identity.py

RUN python -c "import importlib; [importlib.import_module(name) for name in ( \
    'app.channel_agent.staging_object_janitor_cli', \
    'app.channel_agent.worker_redis_marker_janitor_cli', \
    'app.channel_agent.worker_redis_marker_readiness_cli', \
    'app.services.worker_control_role_cli', \
    'app.services.worker_deployment_cli', \
    'app.services.worker_marker_control_role_cli', \
    'app.services.worker_redis_marker_control', \
    'app.services.worker_redis_marker_repair_cli', \
    'app.services.worker_registration_operator_cli', \
    'app.services.worker_runtime_role_cli' \
)]"

CMD ["python", "-m", "worker.main"]
