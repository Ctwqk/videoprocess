FROM golang:1.25-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VP_BUILD_COMMIT
RUN printf '%s\n' "$VP_BUILD_COMMIT" | grep -Eq '^[0-9a-f]{40}$'
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.buildCommit=$VP_BUILD_COMMIT" \
    -o /out/vp-ffmpeg-worker-go ./cmd/vp-ffmpeg-worker

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

ARG VP_BUILD_COMMIT
RUN printf '%s\n' "$VP_BUILD_COMMIT" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision=$VP_BUILD_COMMIT
ENV VP_BUILD_COMMIT=$VP_BUILD_COMMIT

COPY --from=build /out/vp-ffmpeg-worker-go /usr/local/bin/vp-ffmpeg-worker-go

CMD ["vp-ffmpeg-worker-go"]
